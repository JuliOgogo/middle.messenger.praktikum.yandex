:root {
  --primary-color: #3369F3;
  --secondary-color: #E4EDFD;
  --background-color: #FFFFFF;
  --text-color: #1E1E1E;
  --secondary-text-color: #999999;
  --error-color: #e74c3c;
}

*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Inter, sans-serif;
}

h1, h2, h3 {
  color: var(--text-color);
}

h1 {
  font-size: 40px;
}

h2 {
  font-size: 20px;
}

.mb40 {
  margin-bottom: 40px;
}

.app {
  background-color: var(--background-color);
  height: 100vh;
  width: 100vw;
}

.input, .select, .button {
  margin: 10px 0;
  padding: 10px;
  width: 100%;
  box-sizing: border-box;
}

.button {
  border-radius: 8px;
}

.button {
  background-color: var(--primary-color);
  color: white;
  border: none;
  cursor: pointer;
  transition: background-color 0.3s ease;

  &:hover {
    background-color: color-mix(in srgb, var(--primary-color) 80%, black);
  }

  &:disabled {
    background-color: #bdc3c7;
    cursor: not-allowed;
  }
}

ul {
  list-style-type: none;
  padding: 0;
}

li {
  background-color: white;
  margin: 10px 0;
  padding: 10px;
  border-radius: 3px;
  box-shadow: 0 0 5px rgba(0, 0, 0, 0.1);
}

.error {
  color: var(--error-color);
  font-weight: bold;
}

.link {
  color: var(--primary-color);
  text-decoration: none;
  font-size: 11px;

  &:hover {
    text-decoration: underline;
  }
}

.footer {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 20px;
  padding: 20px;
  border-top: 1px solid var(--secondary-color);
}

.footer-link {
  color: var(--primary-color);
  text-decoration: none;
  font-weight: bold;

  &:hover {
    text-decoration: underline;
  }
}

.errorPageWrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;

  .message {
    margin: 20px 0 60px;
    font-weight: 500;
    font-size: 20px;
  }
}

.loginPage {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;

  .loginPageWrapper {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-align: center;
    width: 340px;
    height: 450px;
    padding: 50px 30px 30px;
    border-radius: 12px;
    border: 1px solid var(--secondary-color);
    box-shadow: 0 0 5px rgba(0, 0, 0, 0.1);
  }
}
