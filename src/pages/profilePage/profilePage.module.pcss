.profilePage {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 60px;

  .avatarWrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 100px;

    .avatar {
      width: 130px;
      height: 130px;
      margin-bottom: 20px;
      border-radius: 50%;
      background-color: #EFEFEF;
    }
  }

  .contentWrapper {
    width: 500px;
  }

  .contentWrapper > *:not(:last-child) {
    border-bottom: 1px solid #EAEAEA;
    padding-bottom: 8px;
    margin-bottom: 8px;
  }

  .exit {
    font-size: 13px;
    color: red;
  }

  .back {
    position: absolute;
    left: 0;
    padding: 10px;
    cursor: pointer;
  }

  .buttonWrapper {
    width: 200px;
    margin: 60px auto auto;
  }
}
