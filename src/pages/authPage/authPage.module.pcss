.authPage {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;

  .authPageWrapper {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-align: center;
    width: 340px;
    min-height: 450px;
    padding: 50px 30px 30px;
    border-radius: 12px;
    border: 1px solid var(--secondary-color);
    box-shadow: 0 0 5px rgba(0, 0, 0, 0.1);
  }

  .authPageButtons {
    margin-top: 30px;
  }
}
